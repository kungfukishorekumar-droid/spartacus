# Copy this file to ".env" and fill in real values. NEVER commit the real .env.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGODB_URI=your_mongodb_connection_string_here

# Admin login: POST /api/admin/login with ADMIN_PASSWORD returns a JWT signed with JWT_SECRET.
# Generate a strong JWT_SECRET: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_long_random_jwt_secret_here
ADMIN_PASSWORD=your_admin_password_here

# Razorpay (Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Automation webhooks (optional): new leads + paid payments are POSTed here (n8n -> CRM/WhatsApp/Sheets)
N8N_WEBHOOK_URL=
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=

# Comma-separated website origins allowed to call this backend
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
