# ============================================================
# Spartacus Blog — environment
# Copy to .env.local for local development. Set the same keys on the
# Hostinger Node.js app (hPanel → Node.js → Environment variables).
# NEVER commit the filled-in file.
# ============================================================

# --- Site ---------------------------------------------------------------
# Public origin of the blog, no trailing slash. Every canonical URL, sitemap
# entry, JSON-LD @id and Open Graph URL is built from this.
#
# MUST BE SET AT BUILD TIME, not only at runtime: robots.txt is generated per
# request, but the homepage, sitemap.xml and llms.txt are prerendered during
# the build and freeze this value in. A build without it silently ships
# canonical URLs pointing at the wrong domain — the build log warns when this
# happens, so watch for it.
SITE_URL=https://blog.spartacusmartialarts.com

# Where the blog is mounted on that origin.
#   empty  → the blog owns the whole origin (subdomain deployment)
#   /blog  → the blog is a subfolder of the main site
# Set this at BUILD time as well as runtime; Next needs it to prefix every
# asset and route. Switching it changes every canonical URL, so pick one and
# add redirects if you ever move.
BASE_PATH=

# --- Supabase -----------------------------------------------------------
# Project URL and keys: Supabase dashboard → Project Settings → API.
#
# Deliberately NOT named NEXT_PUBLIC_*: Next inlines every NEXT_PUBLIC_
# reference at build time, in the server bundle too, so a host that builds
# without them would bake in `undefined` and ignore the runtime values
# forever. Nothing client-side touches Supabase, so these are read at runtime
# and can be set on the host alone.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# The anon key is limited by Row Level Security to published posts only.
SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses Row Level Security. Used by /admin and the publish
# pipeline. If this leaks, anyone can rewrite the blog — rotate it immediately
# in the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Images --------------------------------------------------------------
# There is no image API. Images are made in whichever generator you prefer
# (the admin editor gives you brand-consistent prompts to copy) and their URLs
# pasted into the post. spartacusmartialarts.com and Supabase Storage are
# allowed by default; add other hosts here, comma-separated. Read at BUILD
# time, so set it in the build environment too.
# IMAGE_HOSTS=cdn.example.com,another-host.com

# --- Admin ---------------------------------------------------------------
# Generate both with:  npm run hash-password -- "your-long-password"
ADMIN_PASSWORD_HASH=scrypt:REPLACE:ME
ADMIN_SESSION_SECRET=replace-with-32-random-bytes-hex

# Optional: shared token for POST /api/publish, so Make.com or a cron job can
# publish a post without a browser session. Leave unset to disable that path.
# PUBLISH_API_TOKEN=

# --- Compatibility -------------------------------------------------------
# NEXT_PUBLIC_SITE_URL / NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY
# are still read as fallbacks if you already have them set somewhere. Prefer
# the names above.
