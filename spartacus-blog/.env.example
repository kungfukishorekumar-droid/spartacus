# ============================================================
# Spartacus Blog — environment
# Copy to .env.local for local development. Set the same keys in the
# Hostinger Node.js app's environment variables for production.
# NEVER commit the filled-in file.
# ============================================================

# --- Site ---------------------------------------------------------------
# Public origin of the blog. Every canonical URL, sitemap entry, JSON-LD @id
# and Open Graph URL is built from this, so it must be exact (no trailing /).
NEXT_PUBLIC_SITE_URL=https://blog.spartacusmartialarts.com

# --- Supabase -----------------------------------------------------------
# Project URL and anon key: Supabase dashboard → Project Settings → API.
# The anon key is safe in the browser — Row Level Security limits it to
# published content only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key: SERVER ONLY. Bypasses Row Level Security. Used by /admin
# and the publish pipeline. If this leaks, anyone can rewrite the blog —
# rotate it immediately in the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Higgsfield (image generation on publish) ---------------------------
HIGGSFIELD_API_KEY=your-higgsfield-api-key
# Override only if your account uses a different base URL or model.
# HIGGSFIELD_API_URL=https://api.higgsfield.ai/v1
# HIGGSFIELD_IMAGE_MODEL=soul

# --- Admin ---------------------------------------------------------------
# Generate both with:  npm run hash-password -- "your-long-password"
ADMIN_PASSWORD_HASH=scrypt:REPLACE:ME
ADMIN_SESSION_SECRET=replace-with-32-random-bytes-hex

# Optional: shared token for POST /api/publish, so Make.com or a cron job can
# publish a post without a browser session. Leave unset to disable that path.
# PUBLISH_API_TOKEN=
