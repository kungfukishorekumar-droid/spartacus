# ============================================================
# SPARTACUS — Hostinger / Apache / LiteSpeed config
#
# Hostinger serves files statically (server.js does NOT run there),
# so this file replaces every protection server.js/vercel.json gave:
#   - blocks secrets (.env), the backend/ folder, and dotfiles
#   - sets security headers
#   - sets caching + compression
#   - serves index.html at /
#
# If you deploy the WHOLE project folder to public_html, this is the
# only thing stopping backend/.env from being downloadable. Keep it.
# ============================================================

# ---- Default document ----
DirectoryIndex index.html

# ---- 1. BLOCK SECRETS & SERVER-SIDE FILES -------------------
# Any .env file (env, .env.example is a placeholder but blocked too to be safe)
<FilesMatch "(^\.env|\.env$|\.env\.)">
  Require all denied
</FilesMatch>

# All dotfiles (.git, .htaccess itself, etc.)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Docs, SQL and build manifests live in the repo but must never be served
<FilesMatch "\.(sql|md)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(image-jobs\.json|package(-lock)?\.json)$">
  Require all denied
</FilesMatch>

# The entire backend/ folder (Node source — never meant to be served)
RewriteEngine On
RewriteRule ^backend/ - [F,L]
# Repository tooling and source that a Git-based deploy also copies across
RewriteRule ^tools/ - [F,L]
RewriteRule ^supabase/ - [F,L]
RewriteRule ^dist-blog/ - [F,L]
RewriteRule ^server\.js$ - [F,L]
RewriteRule (^|/)node_modules/ - [F,L]

# ---- 1b. BLOG MOVED TO ITS OWN HOST -------------------------
# The blog now lives on blog.spartacusmartialarts.com. Its files sit in
# public_html/blog (that is the subdomain's document root), so the old
# main-domain URLs must redirect instead of serving a duplicate copy.
# The HTTP_HOST guard means these rules can never fire on the blog host
# itself, so no redirect loop is possible.
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP_HOST} !^blog\. [NC]
  RewriteRule ^blog\.html$ https://blog.spartacusmartialarts.com/ [R=301,L]

  RewriteCond %{HTTP_HOST} !^blog\. [NC]
  RewriteRule ^blog-post\.html$ https://blog.spartacusmartialarts.com/blog-post.html [R=301,L,QSA]

  RewriteCond %{HTTP_HOST} !^blog\. [NC]
  RewriteRule ^blog/?$ https://blog.spartacusmartialarts.com/ [R=301,L]

  RewriteCond %{HTTP_HOST} !^blog\. [NC]
  RewriteRule ^blog/(.*)$ https://blog.spartacusmartialarts.com/$1 [R=301,L,QSA]
</IfModule>

# ---- 2. SECURITY HEADERS ------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # HSTS — only takes effect once the site is served over HTTPS
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
</IfModule>

# ---- 3. FORCE HTTPS (Hostinger provides a free SSL cert) -----
<IfModule mod_rewrite.c>
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ---- 4. COMPRESSION -----------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
  AddOutputFilterByType DEFLATE application/json image/svg+xml
</IfModule>

# ---- 5. CACHING ---------------------------------------------
# Force strong caching with explicit Cache-Control headers (mod_headers is
# more reliable on Hostinger/LiteSpeed than mod_expires alone, and overrides
# the platform default of max-age=300 that PageSpeed flags).
<IfModule mod_headers.c>
  # Images + fonts: immutable for 1 year (filenames/?v= change on update)
  <FilesMatch "\.(webp|png|jpe?g|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # CSS + JS: 1 week (long enough for repeat visits, short enough for edits)
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # HTML + JSON content: revalidate often so edits show up
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "public, max-age=600, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp        "access plus 1 year"
  ExpiresByType image/png         "access plus 1 year"
  ExpiresByType image/jpeg        "access plus 1 year"
  ExpiresByType image/svg+xml     "access plus 1 year"
  ExpiresByType font/woff2        "access plus 1 year"
  ExpiresByType text/css          "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType application/json  "access plus 10 minutes"
  ExpiresByType text/html         "access plus 10 minutes"
</IfModule>

# ---- 6. CORRECT MIME TYPES ----------------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType application/json .json
  AddType font/woff2 .woff2
</IfModule>

# ---- 7. PRETTY 404 ------------------------------------------
ErrorDocument 404 /index.html
